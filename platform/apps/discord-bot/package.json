{
  "name": "@kush/discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "start:supervised": "node dist/supervisor.js",
    "dev": "tsx src/index.ts",
    "discord:setup": "tsx src/cli.ts setup --dry-run",
    "discord:validate": "tsx src/cli.ts validate",
    "discord:commands": "tsx src/cli.ts commands",
    "discord:inspect": "tsx src/cli.ts inspect",
    "discord:matrix": "tsx src/cli.ts matrix"
  },
  "dependencies": {
    "discord.js": "^14.24.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
