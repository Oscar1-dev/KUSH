# KUSH website server settings. Copy to .env.local (never commit real values).

# The KUSH API (private; the browser never calls it directly).
KUSH_API_URL=http://127.0.0.1:4310

# Shared with the API's KUSH_WEBSITE_SECRET. At least 32 random characters.
KUSH_WEBSITE_SECRET=

# Set to true only when running behind a proxy/tunnel you control
# (e.g. Cloudflare Tunnel), so per-visitor rate limits use the real IP.
KUSH_TRUST_PROXY=false

# Secure (__Host-) cookies are automatic in production; force them for https dev.
# KUSH_SECURE_COOKIES=true

# Public origin of this website, used for redirects (no trailing slash).
KUSH_SITE_URL=http://127.0.0.1:3000

# Public KUSH Discord invite shown on /contact (e.g. https://discord.gg/xxxx).
# Leave empty to show "invite link coming soon".
KUSH_DISCORD_INVITE_URL=
